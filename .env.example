# Copy to .env (git-ignored) and adjust. docker compose reads it on its own.

# The dashboard password. The monitor refuses to start without one unless
# HM_OPEN=1, which is only fit for a machine nobody else can reach.
HM_PASS=
HM_OPEN=

# The zone for timestamps that arrive without an offset, e.g. Europe/Warsaw.
TZ=

# Host ports.
HM_HTTP_PORT=8081
HM_UDP_PORT=8082

# The soak profile: which file in the repo root describes the traffic, and how
# often it prints a report.
SOAK_CONFIG=soak.yaml
SOAK_REPORT=1m
